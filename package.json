{
  "name": "terevo-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Cross-platform family tree editor",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "prestart": "vite build",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test frontend-tests/*.test.mjs",
    "dist": "npm run build && electron-builder --mac --win",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "electron-builder": "27.0.0-alpha.9",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@electron/rebuild": "^4.2.0",
    "tar": "^7.5.22"
  },
  "build": {
    "appId": "me.terevo.app",
    "productName": "Terevo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/install/terevo-backend",
        "to": "backend"
      }
    ],
    "mac": {
      "icon": "electron/assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
